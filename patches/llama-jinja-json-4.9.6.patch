+// Keep JSON serialization independent of MSVC iostream locale/facet dispatch.
+// Recorded crash: value_to_json -> basic_ostream -> basic_ios::widen -> 0xffffff00.
+// This removes that observed path; it does not assert the origin of prior memory corruption.
+class json_string_sink {
+    std::string output;
+public:
+    json_string_sink & operator<<(std::string_view text) {
+        if (!text.empty()) output.append(text.data(), text.size());
+        return *this;
+    }
+    json_string_sink & operator<<(char text) {
+        output.push_back(text);
+        return *this;
+    }
+    json_string_sink & operator<<(int64_t number) {
+        char buffer[64];
+        const auto result = std::to_chars(buffer, buffer + sizeof(buffer), number);
+        if (result.ec != std::errc{}) throw std::runtime_error("JSON integer formatting failed");
+        output.append(buffer, result.ptr);
+        return *this;
+    }
+    json_string_sink & operator<<(double number) {
+        char buffer[128];
+        // Match default ostream significant-digit precision, with JSON's decimal point.
+        const auto result = std::to_chars(buffer, buffer + sizeof(buffer), number, std::chars_format::general, 6);
+        if (result.ec != std::errc{}) throw std::runtime_error("JSON float formatting failed");
+        output.append(buffer, result.ptr);
+        return *this;
+    }
+    const std::string & str() const { return output; }
+};
